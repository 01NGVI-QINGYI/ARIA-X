# Copy to .env and fill in. NEVER commit .env.
# Used by docker/docker-compose.yml.

# Required whenever the console is reachable by anything other than you.
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(16))'
ARIA_X_AUTH_TOKEN=change-me-before-use

# Model provider (openai | anthropic | ollama | mock | scenario)
ARIA_X_PROVIDER=openai
ARIA_X_BASE_URL=https://api.deepseek.com/v1
ARIA_X_MODEL=deepseek-chat
ARIA_X_API_KEY=

# Logging
ARIA_X_LOG_LEVEL=INFO

# Sandbox backend inside the ARIA-X container: keep "local".
# Use "docker" only when ARIA-X runs on the host with a Docker daemon.
ARIA_X_SANDBOX=local
