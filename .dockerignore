# Keep the build context small and free of secrets/local state.
.git
.gitignore
._*
*.pyc
__pycache__/
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
data/
runs/
logs/
backups/
*.log
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
tests/
examples/
assets/
docs/
scripts/
docker/kali-sandbox.md
node_modules/
venv/
.venv/
.DS_Store
